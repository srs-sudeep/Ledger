# Lyari — production (copy to .env: cp .env.prod .env)
# Used by docker compose -f docker-compose.prod.yml

COMPOSE_PROJECT_NAME=lyari

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=ledger
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=ledger
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── API (FastAPI) ───────────────────────────────────────────
DATABASE_URL=postgresql://ledger:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/ledger
JWT_SECRET=CHANGE_ME_GENERATE_LONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost,http://YOUR_SERVER_IP,http://your-domain.local
API_PORT=8000

# ── Web (Bun build + nginx) ─────────────────────────────────
# Leave empty — nginx proxies /api to the api service.
VITE_API_URL=
WEB_PORT=80

# ── Mobile (Flutter APK build / device run) ─────────────────
API_BASE_URL=http://YOUR_SERVER_IP:8000

# ── Portainer ───────────────────────────────────────────────
PORTAINER_PORT=9000
PORTAINER_HTTPS_PORT=9443

# ── Google Sign-In (optional) ───────────────────────────────
GOOGLE_CLIENT_ID=
