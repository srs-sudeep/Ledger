# Ledger — production (copy to .env: cp .env.prod .env)
# Used by docker compose -f docker-compose.prod.yml

COMPOSE_PROJECT_NAME=ledger

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=ledger
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=ledger
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── API (FastAPI) ───────────────────────────────────────────
DATABASE_URL=postgresql://ledger:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/ledger
JWT_SECRET=CHANGE_ME_GENERATE_LONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://192.168.1.6,http://100.118.104.48,http://hp.tail936c6d.ts.net,http://localhost
# Kept for compose compatibility; API is not published on the host in prod
API_PORT=8000

# ── Web (Bun build + nginx) ─────────────────────────────────
# Leave empty — nginx proxies /api to the api service.
VITE_API_URL=
WEB_PORT=80

# ── Mobile (Flutter APK build / device run) ─────────────────
# Point at nginx (port 80) over Tailscale — install Tailscale on the phone.
API_BASE_URL=http://100.118.104.48

# ── Portainer ───────────────────────────────────────────────
PORTAINER_PORT=9000
PORTAINER_HTTPS_PORT=9443

# ── Google Sign-In (optional) ───────────────────────────────
GOOGLE_CLIENT_ID=
