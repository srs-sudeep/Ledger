# Ledger — development (copy to .env: cp .env.dev .env)
# Used by docker compose -f docker-compose.dev.yml

COMPOSE_PROJECT_NAME=ledger-dev

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── API (FastAPI) ───────────────────────────────────────────
DATABASE_URL=postgresql://ledger:ledger@db:5432/ledger
JWT_SECRET=dev-secret-not-for-production
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://192.168.1.2:5173
API_PORT=8000

# ── Web (Bun + Vite) ────────────────────────────────────────
# Empty = Vite dev proxy to api:8000. Set only if calling API directly.
VITE_API_URL=
WEB_PORT=5173

# ── Mobile (Flutter — pass at run/build time) ───────────────
# Use host LAN IP when testing on a physical device.
API_BASE_URL=http://192.168.1.2:8000

# ── Portainer (container logs & UI) ───────────────────────────
PORTAINER_PORT=9000
PORTAINER_HTTPS_PORT=9443

# ── Google Sign-In (optional) ─────────────────────────────────
# Create OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Web: authorized origins http://localhost:5173, Android: package + SHA-1
GOOGLE_CLIENT_ID=
